# NMAKE makefile for MSVC (cl.exe).
# Run from a "Developer Command Prompt for VS" (or after vcvars64.bat):
#   nmake /nologo /f Makefile.msvc          build build\gale.exe
#   nmake /nologo /f Makefile.msvc test     build and run the tests
#   nmake /nologo /f Makefile.msvc clean

CC = cl
CFLAGS = /nologo /std:c11 /W4 /O2 /D_CRT_SECURE_NO_WARNINGS /Isrc
BUILD = build

LIB_SRCS = src\lexer.c src\arena.c src\parser.c src\ast_dump.c src\fsutil.c src\unfold.c
HDRS = src\lexer.h src\arena.h src\ast.h src\parser.h src\fsutil.h src\unfold.h src\common.h

all: $(BUILD)\gale.exe

$(BUILD)\gale.exe: src\main.c $(LIB_SRCS) $(HDRS)
	@if not exist $(BUILD) mkdir $(BUILD)
	$(CC) $(CFLAGS) /Fo$(BUILD)\ /Fe$@ src\main.c $(LIB_SRCS)

$(BUILD)\test_lexer.exe: tests\test_lexer.c $(LIB_SRCS) $(HDRS)
	@if not exist $(BUILD) mkdir $(BUILD)
	$(CC) $(CFLAGS) /Fo$(BUILD)\ /Fe$@ tests\test_lexer.c $(LIB_SRCS)

$(BUILD)\test_arena.exe: tests\test_arena.c $(LIB_SRCS) $(HDRS)
	@if not exist $(BUILD) mkdir $(BUILD)
	$(CC) $(CFLAGS) /Fo$(BUILD)\ /Fe$@ tests\test_arena.c $(LIB_SRCS)

$(BUILD)\test_parser.exe: tests\test_parser.c $(LIB_SRCS) $(HDRS)
	@if not exist $(BUILD) mkdir $(BUILD)
	$(CC) $(CFLAGS) /Fo$(BUILD)\ /Fe$@ tests\test_parser.c $(LIB_SRCS)

$(BUILD)\test_unfold.exe: tests\test_unfold.c $(LIB_SRCS) $(HDRS)
	@if not exist $(BUILD) mkdir $(BUILD)
	$(CC) $(CFLAGS) /Fo$(BUILD)\ /Fe$@ tests\test_unfold.c $(LIB_SRCS)

test: $(BUILD)\gale.exe $(BUILD)\test_lexer.exe $(BUILD)\test_arena.exe $(BUILD)\test_parser.exe $(BUILD)\test_unfold.exe
	$(BUILD)\test_lexer.exe
	$(BUILD)\test_arena.exe
	$(BUILD)\test_parser.exe
	$(BUILD)\test_unfold.exe
	@for %%f in (examples\*.gale) do (echo lex+parse %%f && $(BUILD)\gale.exe lex %%f > nul && $(BUILD)\gale.exe parse %%f > nul || exit 1)

clean:
	@if exist $(BUILD) rmdir /s /q $(BUILD)
